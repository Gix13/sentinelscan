NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=file:./prisma/dev.db
UPLOAD_DIR=./uploads
QUARANTINE_DIR=./uploads/quarantine
MAX_FILE_MB=25

# Generate a unique local value. Never commit the real token.
ADMIN_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Active scanners are opt-in in the sanitized public version.
ENABLE_NMAP=false
ENABLE_CLAMSCAN=false
ENABLE_METASPLOIT=false
ENABLE_PHISHING_ML=false
ENABLE_NETWORK_ML=false

# Optional integrations. Keep the real values only in apps/backend/.env.
VIRUSTOTAL_API_KEY=
PYTHON_PATH=
MSFCONSOLE_PATH=msfconsole
